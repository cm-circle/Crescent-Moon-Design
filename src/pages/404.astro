---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found — Crescent Moon Design">
  <section class="not-found">
    <div class="wrap">
      <span class="tag">404</span>
      <h1>Page not found</h1>
      <p>This page doesn't exist or has been moved.</p>
      <a href="/" class="btn btn--primary">Back to home</a>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: 8rem 0 6rem;
  }
  .not-found .tag {
    font-family: var(--font-mono);
    color: var(--red);
  }
  .not-found h1 {
    margin: 1.5rem 0 1rem;
  }
  .not-found p {
    font-size: 1.1rem;
    max-width: 400px;
    margin: 0 auto 2rem;
  }
</style>
