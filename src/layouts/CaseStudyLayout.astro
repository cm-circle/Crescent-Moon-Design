---
import BaseLayout from './BaseLayout.astro';
import StatsGrid from '../components/StatsGrid.astro';
import TestimonialBlock from '../components/TestimonialBlock.astro';

interface Props {
  title: string;
  tagline: string;
  category: string;
  stats: Array<{ label: string; value: string }>;
  testimonial?: {
    quote: string;
    author: string;
    role: string;
  };
  timeline?: string;
  budget?: string;
  ongoing?: string;
}

const { title, tagline, category, stats, testimonial, timeline, budget, ongoing } = Astro.props;
---

<BaseLayout title={`${title} — Crescent Moon Design`}>
  <article class="case-study">
    <div class="wrap wrap--narrow">
      <a href="/case-studies" class="back-link">&larr; All Case Studies</a>

      <p class="tag">{category}</p>
      <h1>{title}</h1>
      <p class="case-study__subtitle">{tagline}</p>

      <StatsGrid stats={stats} />

      <div class="prose">
        <slot />
      </div>

      {testimonial && (
        <TestimonialBlock {...testimonial} />
      )}

      {(timeline || ongoing) && (
        <div class="case-study__engagement">
          <h2>Engagement Details</h2>
          <p>
            {timeline && <><strong>Timeline:</strong> {timeline}<br /></>}
            {budget && <><strong>Budget:</strong> {budget}<br /></>}
            {ongoing && <><strong>Ongoing:</strong> {ongoing}</>}
          </p>
        </div>
      )}

      <nav class="case-study__nav">
        <a href="/case-studies" class="btn btn--ghost">View All Case Studies</a>
      </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .case-study {
    padding: 4rem 0 6rem;
  }

  .back-link {
    display: inline-block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 3rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: var(--fg);
  }

  .case-study__subtitle {
    font-size: 1.15rem;
    color: var(--accent);
    margin-bottom: 3rem;
    font-weight: 300;
  }

  .case-study__engagement {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .case-study__engagement h2 {
    font-size: 1.3rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .case-study__nav {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }
</style>
