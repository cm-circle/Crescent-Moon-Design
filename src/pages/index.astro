---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Crescent Moon Design — We craft digital experiences that eclipse the ordinary.">

  <!-- Docked moon logo -->
  <div class="moon-dock">
    <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
      <defs>
        <mask id="dock-mask">
          <rect width="400" height="400" fill="black"/>
          <circle cx="200" cy="200" r="185" fill="white"/>
          <circle cx="288" cy="200" r="130" fill="black"/>
        </mask>
      </defs>
      <image xlink:href="/Crescent-Moon-Design/moon.webp" x="15" y="15" width="370" height="370"
             preserveAspectRatio="xMidYMid slice" mask="url(#dock-mask)"/>
    </svg>
  </div>

  <!-- Hero -->
  <section class="hero">
    <div class="hero__moon-container">
      <div class="hero__moon-glow"></div>
      <svg class="hero__moon-svg" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
        <defs>
          <mask id="eclipse-mask">
            <rect width="400" height="400" fill="black"/>
            <circle cx="200" cy="200" r="185" fill="white"/>
            <circle class="eclipse-shadow" cx="620" cy="200" r="130" fill="black"/>
          </mask>
        </defs>
        <image class="moon-img" xlink:href="/Crescent-Moon-Design/moon.webp"
                       x="15" y="15" width="370" height="370"
                       preserveAspectRatio="xMidYMid slice"
                       mask="url(#eclipse-mask)"/>
              </svg>

              <div class="hero__text">
                <h1 class="hero__title agency-name">Crescent Moon Design</h1>
                <p class="hero__tagline tagline">We craft digital experiences that eclipse the ordinary</p>
                <p class="hero__services services-intro">Web Design &bull; Social Media &bull; SEO / GEO</p>
              </div>
            </div>
            <div class="hero__scroll-cue">
              <span class="hero__scroll-text">Scroll</span>
            </div>
          </section>

</BaseLayout>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
<script is:inline src="https://unpkg.com/split-type@0.3.4/umd/index.min.js" defer></script>
<script is:inline>
(function() {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('reduced-motion');
    return;
  }
  var timeout = setTimeout(function() { console.warn('[CMDesign] GSAP timed out'); }, 3000);
  function tryInit() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined' || typeof SplitType === 'undefined') return;
    clearTimeout(timeout);
    gsap.registerPlugin(ScrollTrigger);

    var tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    // Phase 1: Moon entrance
    tl.fromTo('.hero__moon-svg', { scale: 0.9, opacity: 0 }, { scale: 1, opacity: 1, duration: 1.2, ease: 'power2.out' });
    tl.to('.hero__moon-glow', { opacity: 1, duration: 0.8, ease: 'sine.inOut' }, '-=0.4');
    tl.to({}, { duration: 0.5 });

    // Phase 2: Eclipse + text sweep
    var sweepDur = 2.4;
    var sweepEase = 'power2.inOut';
    tl.to('.eclipse-shadow', { attr: { cx: 288 }, duration: sweepDur, ease: sweepEase });
    tl.fromTo('.hero__text', { opacity: 0, x: 60 }, { opacity: 1, x: 0, duration: sweepDur * 0.8, ease: sweepEase }, '-=0.6');
    tl.to('.hero__moon-glow', { opacity: 0.3, duration: sweepDur, ease: 'sine.in' }, '<');

    // Phase 3: Character settle
    var nameSplit = new SplitType('.agency-name', { types: 'chars' });
    var taglineSplit = new SplitType('.tagline', { types: 'words' });
    var introSplit = new SplitType('.services-intro', { types: 'chars' });
    tl.to('.hero__moon-glow', { opacity: 0.7, scale: 1.06, duration: 0.5, ease: 'power2.out' });
    tl.to('.hero__moon-glow', { opacity: 0.4, scale: 1, duration: 0.9, ease: 'sine.inOut' });
    tl.to(nameSplit.chars, { opacity: 1, x: 0, duration: 0.55, stagger: 0.028, ease: 'power3.out' }, '-=1.1');
    tl.to(taglineSplit.words, { opacity: 1, x: 0, duration: 0.45, stagger: 0.05, ease: 'power3.out' }, '-=0.7');
    tl.to(introSplit.chars, { opacity: 1, x: 0, duration: 0.35, stagger: 0.012, ease: 'power2.out' }, '-=0.4');

    // Phase 4: Moon docks
    gsap.to('.hero__moon-container', {
      scrollTrigger: { trigger: '.hero', start: '60% top', end: 'bottom top', scrub: 1 },
      scale: 0.08, x: function() { return -window.innerWidth * 0.42; }, y: function() { return -window.innerHeight * 0.38; }, opacity: 0, ease: 'none'
    });
    gsap.to('.moon-dock', {
      scrollTrigger: { trigger: '.hero', start: '75% top', end: 'bottom top', scrub: 1 },
      opacity: 1, scale: 1, ease: 'none'
    });
  }
  if (typeof gsap !== 'undefined') { tryInit(); }
  else {
    var iv = setInterval(function() {
      if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined' && typeof SplitType !== 'undefined') {
        clearInterval(iv); tryInit();
      }
    }, 100);
  }
})();
</script>

<style>
  /* === HERO === */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    min-height: 100vh;
    padding-top: 12vh;
    overflow: hidden;
    background: var(--bg) url('https://cm-circle.github.io/Crescent-Moon-Design/nightsky.webp') center center / cover no-repeat fixed;
  }
  @supports not (background: url('https://cm-circle.github.io/Crescent-Moon-Design/nightsky.webp')) {
    .hero { background: var(--bg) url('https://cm-circle.github.io/Crescent-Moon-Design/nightsky.jpg') center center / cover no-repeat fixed; }
  }
  .hero::before {
    content: ''; position: absolute; inset: 0;
    background: rgba(5, 5, 8, 0.55); z-index: 1; pointer-events: none;
  }
  .hero__moon-container {
    position: relative; width: clamp(420px, 58vw, 780px); height: clamp(420px, 58vw, 780px);
    flex-shrink: 0; margin-left: clamp(-60px, -4vw, -20px); overflow: visible; z-index: 2;
  }
  .hero__moon-svg { width: 100%; height: 100%; display: block; }
  .moon-img { display: block; }
  .hero__moon-glow {
    position: absolute; inset: -15%; border-radius: 50%;
    background: radial-gradient(circle, var(--glow) 0%, transparent 65%);
    opacity: 0; pointer-events: none;
  }
  .hero__text {
      position: absolute; z-index: 3; left: 42%; top: 50%;
      transform: translateY(-50%) translateX(60px); opacity: 0; text-align: left; white-space: nowrap;
    }
  .hero__title { font-size: clamp(2.7rem, 4.8vw, 4.5rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.08; margin-bottom: 0.9rem; color: var(--fg); }
  .hero__tagline { font-size: clamp(1.28rem, 2.1vw, 1.65rem); font-weight: 300; color: var(--accent); margin-bottom: 1.4rem; letter-spacing: 0.01em; line-height: 1.5; }
  .hero__services { font-size: clamp(0.98rem, 1.5vw, 1.2rem); color: var(--muted); text-transform: uppercase; letter-spacing: 0.18em; }
  .hero__scroll-cue {
    position: absolute; bottom: 2.5rem; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 0.4rem; z-index: 2;
  }
  .hero__scroll-text { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.22em; color: var(--muted); }
  @keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }

  /* === DOCKED MOON === */
  .moon-dock {
    position: fixed; top: 16px; left: 16px; width: 52px; height: 52px;
    z-index: 100; opacity: 0; transform: scale(0.5); pointer-events: none;
  }
  .moon-dock svg { width: 100%; height: 100%; }

  /* === BUTTONS === */
  .btn { display: inline-block; padding: 0.9rem 2rem; border-radius: 8px; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; transition: all 0.2s; cursor: pointer; }
  .btn--primary { background: var(--red); color: #fff; border: 1px solid var(--red); }
  .btn--primary:hover { background: transparent; color: var(--red); }
  .btn--outline-teal { background: transparent; color: var(--blue); border: 1px solid var(--blue); }
  .btn--outline-teal:hover { background: rgba(46,196,182,0.1); }

  /* === SplitType === */
  .agency-name .char { display: inline-block; opacity: 0; transform: translateX(30px); }
  .tagline .word { display: inline-block; opacity: 0; transform: translateX(24px); }
  .services-intro .char { display: inline-block; opacity: 0; transform: translateX(16px); }

  /* === RESPONSIVE === */
  @media (max-width: 900px) {
      /* Too small to keep text + moon side by side — stack text under the moon */
      .hero { flex-direction: column; justify-content: center; padding: 2rem 1rem; }
      .hero__moon-container { margin-left: 0; width: clamp(300px, 70vw, 520px); height: clamp(300px, 70vw, 520px); }
      .hero__text { position: relative; left: 0; top: auto; transform: none; max-width: 100%; margin: 1.5rem auto 0; text-align: center; white-space: normal; }
    }
  @media (prefers-reduced-motion: reduce) {
    .hero__moon-svg, .hero__moon-glow, .hero__text, .moon-dock { opacity: 1 !important; transform: none !important; }
    .agency-name .char, .tagline .word, .services-intro .char { opacity: 1 !important; transform: none !important; }
  }
</style>