---
const navLinks = [
  { href: '/#section-web', label: 'Web' },
  { href: '/#section-social', label: 'Social' },
  { href: '/#section-seo', label: 'SEO & AI' },
  { href: '/services/automation', label: 'Automation' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <nav class="site-nav">
    <a href="/" class="site-nav__brand">
      <svg class="site-nav__moon" viewBox="0 0 400 400" width="28" height="28" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
        <defs>
          <mask id="header-mask">
            <rect width="400" height="400" fill="black"/>
            <circle cx="200" cy="200" r="185" fill="white"/>
            <circle cx="288" cy="200" r="130" fill="black"/>
          </mask>
        </defs>
        <image xlink:href="/Crescent-Moon-Design/moon.webp" x="15" y="15" width="370" height="370"
               preserveAspectRatio="xMidYMid slice" mask="url(#header-mask)"/>
      </svg>
      Crescent Moon Design
    </a>
    <div class="site-nav__links">
      {navLinks.map(link => (
        <a href={link.href} class="site-nav__link">{link.label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(5, 5, 8, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .site-nav {
    max-width: none;
    margin: 0;
    padding: 0 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }

  .site-nav__brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--fg);
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .site-nav__moon {
    flex-shrink: 0;
    border-radius: 50%;
    overflow: hidden;
  }

  .site-nav__links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .site-nav__link {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .site-nav__link:hover {
    color: var(--fg);
  }

  @media (max-width: 700px) {
    .site-nav__links {
      display: none;
    }
  }
</style>
