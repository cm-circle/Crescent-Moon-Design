{"type":"excalidraw","version":2,"source":"hermes-agent","elements":[{"type":"rectangle","id":"bg3","x":-200,"y":-100,"width":1400,"height":2200,"fillStyle":"solid","backgroundColor":"#fafafa","strokeColor":"transparent"},{"type":"text","id":"t1","x":150,"y":50,"width":800,"height":60,"text":"WIREFRAME 3: Modular / Systems View","fontSize":28,"fontFamily":1,"strokeColor":"#1a1a2e","originalText":"WIREFRAME 3: Modular / Systems View","autoResize":true},{"type":"text","id":"t2","x":150,"y":110,"width":900,"height":40,"text":"Hero → three equal columns (services) → process grid → automation teaser → CTA","fontSize":18,"fontFamily":1,"strokeColor":"#666","originalText":"Hero → three equal columns (services) → process grid → automation teaser → CTA","autoResize":true},{"type":"rectangle","id":"c1","x":150,"y":200,"width":300,"height":420,"roundness":{"type":3},"strokeColor":"#e0e0e0","strokeWidth":1,"backgroundColor":"transparent","boundElements":[{"type":"text","id":"t_c1"}]},{"type":"text","id":"t_c1","x":175,"y":220,"width":250,"height":380,"text":"WEB DESIGN\n────────────────\nSites that pull their weight\n\n• Clear offer — every page has a job\n• Mobile-first — thumbs first\n• Fast pages — sub-second paint\n• Easy edits — you own content\n• Accessible — WCAG 2.1 AA\n\n[details →]","fontSize":16,"fontFamily":1,"strokeColor":"#1a1a2e","originalText":"WEB DESIGN\n────────────────\nSites that pull their weight\n\n• Clear offer — every page has a job\n• Mobile-first — thumbs first\n• Fast pages — sub-second paint\n• Easy edits — you own content\n• Accessible — WCAG 2.1 AA\n\n[details →]","autoResize":true,"containerId":"c1","textAlign":"left","verticalAlign":"top"},{"type":"rectangle","id":"c2","x":480,"y":200,"width":300,"height":420,"roundness":{"type":3},"strokeColor":"#e0e0e0","strokeWidth":1,"backgroundColor":"#f5f5f5","fillStyle":"solid","boundElements":[{"type":"text","id":"t_c2"}]},{"type":"text","id":"t_c2","x":505,"y":220,"width":250,"height":380,"text":"SOCIAL MEDIA\n────────────────\nContent with gravitational pull\n\n• Platform-native creative\n• Monthly calendars — zero panic\n• Brand voice — defined once\n• Community — builds loyalty\n• Reporting — know what works\n\n[details →]","fontSize":16,"fontFamily":1,"strokeColor":"#1a1a2e","originalText":"SOCIAL MEDIA\n────────────────\nContent with gravitational pull\n\n• Platform-native creative\n• Monthly calendars — zero panic\n• Brand voice — defined once\n• Community — builds loyalty\n• Reporting — know what works\n\n[details →]","autoResize":true,"containerId":"c2","textAlign":"left","verticalAlign":"top"},{"type":"rectangle","id":"c3","x":810,"y":200,"width":300,"height":420,"roundness":{"type":3},"strokeColor":"#e0e0e0","strokeWidth":1,"backgroundColor":"transparent","boundElements":[{"type":"text","id":"t_c3"}]},{"type":"text","id":"t_c3","x":835,"y":220,"width":250,"height":380,"text":"SEO / GEO\n────────────────\nFound by the right people\n\n• Technical audits — fix blockers\n• Local SEO — dominate zip code\n• Content architecture\n• GEO — AI answer engines\n• Link building — earned trust\n\n[details →]","fontSize":16,"fontFamily":1,"strokeColor":"#1a1a2e","originalText":"SEO / GEO\n────────────────\nFound by the right people\n\n• Technical audits — fix blockers\n• Local SEO — dominate zip code\n• Content architecture\n• GEO — AI answer engines\n• Link building — earned trust\n\n[details →]","autoResize":true,"containerId":"c3","textAlign":"left","verticalAlign":"top"},{"type":"text","id":"t_proc","x":150,"y":660,"width":900,"height":40,"text":"HOW IT WORKS","fontSize":24,"fontFamily":1,"strokeColor":"#1a1a2e","originalText":"HOW IT WORKS","autoResize":true},{"type":"rectangle","id":"p1","x":150,"y":720,"width":230,"height":180,"roundness":{"type":3},"strokeColor":"#e0e0e0","strokeWidth":1,"backgroundColor":"transparent","boundElements":[{"type":"text","id":"t_p1"}]},{"type":"text","id":"t_p1","x":175,"y":735,"width":180,"height":150,"text":"01\nFIND THE FRICTION\nA short call to locate the leak in your funnel.","fontSize":16,"fontFamily":1,"strokeColor":"#1a1a2e","originalText":"01\nFIND THE FRICTION\nA short call to locate the leak in your funnel.","autoResize":true,"containerId":"p1","textAlign":"center","verticalAlign":"middle"},{"type":"rectangle","id":"p2","x":410,"y":720,"width":230,"height":180,"roundness":{"type":3},"strokeColor":"#e0e0e0","strokeWidth":1,"backgroundColor":"transparent","boundElements":[{"type":"text","id":"t_p2"}]},{"type":"text","id":"t_p2","x":435,"y":735,"width":180,"height":150,"text":"02\nMAKE THE PLAN\nA fixed-price roadmap with no surprise invoices.","fontSize":16,"fontFamily":1,"strokeColor":"#1a1a2e","originalText":"02\nMAKE THE PLAN\nA fixed-price roadmap with no surprise invoices.","autoResize":true,"containerId":"p2","textAlign":"center","verticalAlign":"middle"},{"type":"rectangle","id":"p3","x":670,"y":720,"width":230,"height":180,"roundness":{"type":3},"strokeColor":"#e0e0e0","strokeWidth":1,"backgroundColor":"transparent","boundElements":[{"type":"text","id":"t_p3"}]},{"type":"text","id":"t_p3","x":695,"y":735,"width":180,"height":150,"text":"03\nBUILD THE USEFUL THING\nShips fast, works everywhere, easy to edit.","fontSize":16,"fontFamily":1,"strokeColor":"#1a1a2e","originalText":"03\nBUILD THE USEFUL THING\nShips fast, works everywhere, easy to edit.","autoResize":true,"containerId":"p3","textAlign":"center","verticalAlign":"middle"},{"type":"rectangle","id":"p4","x":930,"y":720,"width":230,"height":180,"roundness":{"type":3},"strokeColor":"#e0e0e0","strokeWidth":1,"backgroundColor":"transparent","boundElements":[{"type":"text","id":"t_p4"}]},{"type":"text","id":"t_p4","x":955,"y":735,"width":180,"height":150,"text":"04\nMEASURE & REFINE\nWe track post-launch and keep improving.","fontSize":16,"fontFamily":1,"strokeColor":"#1a1a2e","originalText":"04\nMEASURE & REFINE\nWe track post-launch and keep improving.","autoResize":true,"containerId":"p4","textAlign":"center","verticalAli