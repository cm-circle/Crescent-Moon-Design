---
const navLinks = [
  { href: '/#section-web', label: 'Web' },
  { href: '/#section-social', label: 'Social' },
  { href: '/#section-seo', label: 'SEO & AI' },
  { href: '/services/automation', label: 'Automation' },
  { href: '/case-studies', label: 'Case Studies' },
  { href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
  <nav class="site-nav">
    <a href="/" class="site-nav__brand" aria-label="Crescent Moon Design — home">
      <span class="brand-mark">
        <svg class="site-nav__moon" viewBox="0 0 400 400" width="64" height="64" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
          <defs>
            <mask id="header-mask">
              <rect width="400" height="400" fill="black"/>
              <circle cx="200" cy="200" r="185" fill="white"/>
              <circle cx="288" cy="200" r="130" fill="black"/>
            </mask>
          </defs>
          <image xlink:href="/Crescent-Moon-Design/moon.webp" x="15" y="15" width="370" height="370"
                 preserveAspectRatio="xMidYMid slice" mask="url(#header-mask)"/>
        </svg>
        <span class="brand-text">
          Crescent Moon
          <span class="brand-text__sub">Design</span>
        </span>
      </span>
    </a>
    <div class="site-nav__links">
      {navLinks.map(link => (
        <a href={link.href} class="site-nav__link">{link.label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(5, 5, 8, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
  }

  .site-nav {
    max-width: none;
    margin: 0;
    padding: 0 0.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 64px;
  }

  .site-nav__brand {
    display: block;
    color: var(--fg);
    text-decoration: none;
  }

  .brand-mark {
    position: relative;
    display: inline-block;
    width: 64px;
    height: 64px;
  }

  .site-nav__moon {
    display: block;
    border-radius: 50%;
    overflow: hidden;
    filter: drop-shadow(0 0 14px rgba(230, 57, 70, 0.25));
  }

  /* Text nestled inside the crescent opening (the concave space of the moon) */
  .brand-text {
    position: absolute;
    left: 39%;
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--fg);
    pointer-events: none;
  }

  .brand-text__sub {
    display: block;
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 1px;
  }

  .site-nav__links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .site-nav__link {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s;
  }

  .site-nav__link:hover {
    color: var(--fg);
  }

  @media (max-width: 700px) {
    .site-nav__links {
      display: none;
    }
  }
</style>