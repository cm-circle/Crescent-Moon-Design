---
interface Stat {
  label: string;
  value: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="stats-row">
  {stats.map(stat => (
    <div class="stat">
      <span class="stat__value">{stat.value}</span>
      <span class="stat__label">{stat.label}</span>
    </div>
  ))}
</div>

<style>
  .stats-row {
    display: flex;
    gap: 2.5rem;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat__value {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--accent);
  }

  .stat__label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    margin-top: 0.2rem;
  }

  @media (max-width: 600px) {
    .stats-row {
      gap: 1.5rem;
    }
  }
</style>
