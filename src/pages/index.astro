---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const cases = await getCollection('caseStudies');
---

<BaseLayout title="Crescent Moon Design — We craft digital experiences that eclipse the ordinary.">

  <!-- Docked moon logo -->
  <div class="moon-dock">
    <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
      <defs>
        <mask id="dock-mask">
          <rect width="400" height="400" fill="black"/>
          <circle cx="200" cy="200" r="185" fill="white"/>
          <circle cx="288" cy="200" r="130" fill="black"/>
        </mask>
      </defs>
      <image xlink:href="/Crescent-Moon-Design/moon.webp" x="15" y="15" width="370" height="370"
             preserveAspectRatio="xMidYMid slice" mask="url(#dock-mask)"/>
    </svg>
  </div>

  <!-- Hero -->
  <section class="hero">
    <div class="hero__moon-container">
      <div class="hero__moon-glow"></div>
      <svg class="hero__moon-svg" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
        <defs>
          <mask id="eclipse-mask">
            <rect width="400" height="400" fill="black"/>
            <circle cx="200" cy="200" r="185" fill="white"/>
            <circle class="eclipse-shadow" cx="620" cy="200" r="130" fill="black"/>
          </mask>
        </defs>
        <image class="moon-img" xlink:href="/Crescent-Moon-Design/moon.webp"
                       x="15" y="15" width="370" height="370"
                       preserveAspectRatio="xMidYMid slice"
                       mask="url(#eclipse-mask)"/>
              </svg>

              <div class="hero__text">
                <h1 class="hero__title agency-name">Crescent Moon Design</h1>
                <p class="hero__tagline tagline">We craft digital experiences that eclipse the ordinary</p>
                <p class="hero__services services-intro">Web Design &bull; Social Media &bull; SEO / GEO</p>
              </div>
            </div>
            <div class="hero__scroll-cue">
              <span class="hero__scroll-text">Scroll</span>
            </div>
          </section>

  <!-- Metrics strip -->
  <div class="metrics-strip">
    <div class="metrics-strip__inner">
      <div class="metrics-strip__item"><span class="metrics-strip__value">+520%</span><span class="metrics-strip__label">engagement</span></div>
      <div class="metrics-strip__item"><span class="metrics-strip__value">+340%</span><span class="metrics-strip__label">organic traffic</span></div>
      <div class="metrics-strip__item"><span class="metrics-strip__value">92</span><span class="metrics-strip__label">Lighthouse</span></div>
      <div class="metrics-strip__item"><span class="metrics-strip__value">38/mo</span><span class="metrics-strip__label">leads</span></div>
    </div>
  </div>

  <!-- Service Detail Rail -->
  <section class="service-detail active" id="detail-web">
    <div class="service-detail__inner">
      <div class="service-detail__visual">
        <div class="browser-frame">
          <div class="browser-bar"><span></span><span></span><span></span></div>
          <div class="browser-content">
            <div class="site-preview">
              <div class="site-preview__sidebar"></div>
              <div class="site-preview__main">
                <div class="site-preview__hero-img"></div>
                <div class="site-preview__line w-60"></div>
                <div class="site-preview__line w-80"></div>
                <div class="site-preview__line w-40"></div>
                <div class="site-preview__grid">
                  <div class="site-preview__card"></div>
                  <div class="site-preview__card"></div>
                  <div class="site-preview__card"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <p class="service-detail__flow">Strategy → Structure → Design → Build → Improve</p>
      </div>
      <div class="service-detail__content">
        <div class="service-detail__number">01</div>
        <h2>Web Design</h2>
        <p class="service-detail__tagline">Sites that pull their weight</p>
        <ul class="service-detail__list">
          <li>✦ <strong>Clear offer</strong> — every page has a job and does it</li>
          <li>✦ <strong>Mobile-first</strong> — built for thumbs first, cursors second</li>
          <li>✦ <strong>Fast pages</strong> — sub-second first paint, no excuses</li>
          <li>✦ <strong>Easy edits</strong> — you own your content, not a plugin</li>
          <li>✦ <strong>Accessible</strong> — WCAG 2.1 AA, built in from the start</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="service-detail" id="detail-social">
    <div class="service-detail__inner">
      <div class="service-detail__visual">
        <div class="browser-frame">
          <div class="browser-bar"><span></span><span></span><span></span></div>
          <div class="browser-content">
            <div class="social-preview">
              <div class="social-preview__grid">
                <div class="social-preview__post"></div>
                <div class="social-preview__post"></div>
                <div class="social-preview__post"></div>
                <div class="social-preview__post"></div>
              </div>
              <div class="social-preview__stat">
                <div class="social-preview__stat-circle">
                  <span>+520%</span>
                  <small>engagement</small>
                </div>
              </div>
            </div>
          </div>
        </div>
        <p class="service-detail__flow">Audit → Voice → Calendar → Create → Measure</p>
      </div>
      <div class="service-detail__content">
        <div class="service-detail__number">02</div>
        <h2>Social Media</h2>
        <p class="service-detail__tagline">Content with gravitational pull</p>
        <ul class="service-detail__list">
          <li>✦ <strong>Platform-native</strong> — each channel gets what it needs</li>
          <li>✦ <strong>Monthly calendars</strong> — consistent, zero panic posting</li>
          <li>✦ <strong>Brand voice</strong> — defined once, used everywhere</li>
          <li>✦ <strong>Community</strong> — engagement that builds loyalty</li>
          <li>✦ <strong>Reporting</strong> — know what's working, kill what isn't</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="service-detail" id="detail-seo">
    <div class="service-detail__inner">
      <div class="service-detail__visual">
        <div class="browser-frame">
          <div class="browser-bar"><span></span><span></span><span></span></div>
          <div class="browser-content">
            <div class="seo-preview">
              <div class="seo-preview__chart">
                <div class="seo-preview__bar" style="height:30%"></div>
                <div class="seo-preview__bar" style="height:50%"></div>
                <div class="seo-preview__bar" style="height:70%"></div>
                <div class="seo-preview__bar seo-preview__bar--highlight" style="height:95%"></div>
              </div>
              <div class="seo-preview__badges">
                <span class="seo-preview__badge">#1 Local Pack</span>
                <span class="seo-preview__badge">+340% Traffic</span>
                <span class="seo-preview__badge">GEO Ready</span>
              </div>
            </div>
          </div>
        </div>
        <p class="service-detail__flow">Audit → Optimize → Publish → Authority → Grow</p>
      </div>
      <div class="service-detail__content">
        <div class="service-detail__number">03</div>
        <h2>SEO / GEO</h2>
        <p class="service-detail__tagline">Found by the right people</p>
        <ul class="service-detail__list">
          <li>✦ <strong>Technical audits</strong> — find and fix what's blocking you</li>
          <li>✦ <strong>Local SEO</strong> — dominate your zip code</li>
          <li>✦ <strong>Content architecture</strong> — structure search engines reward</li>
          <li>✦ <strong>GEO</strong> — optimized for AI answer engines</li>
          <li>✦ <strong>Link building</strong> — earn the trust that rankings measure</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Case Studies -->
  <section class="section section--cases" id="section-cases">
    <div class="wrap">
      <div class="section__header">
        <div>
          <span class="tag">Case Studies</span>
          <h2>Work with a visible before/after,<br>a result, and context.</h2>
        </div>
        <span class="section__label">Work / 2026</span>
      </div>

      <div class="case-cards">
        <div class="case-card case-card--tall">
          <div class="case-card__visual case-card__visual--social">
            <div class="social-card-art">
              <div class="social-card-art__ring"></div>
              <div class="social-card-art__ring social-card-art__ring--sm"></div>
              <div class="social-card-art__stat">
                <span class="social-card-art__num">+520%</span>
                <span class="social-card-art__label">engagement</span>
              </div>
            </div>
          </div>
          <div class="case-card__body">
            <span class="case-card__num">01 / Social</span>
            <h3 class="case-card__title">Brookline Property Group</h3>
            <p class="case-card__desc">Making local listings feel alive — and converting the people who see them.</p>
            <div class="case-card__metrics"><span>38 leads / month</span></div>
            <a href="/case-studies/brookline-property" class="case-card__link">VIEW THE FIELD NOTES →</a>
          </div>
        </div>

        <div class="case-card case-card--tall">
          <div class="case-card__visual case-card__visual--seo">
            <div class="seo-card-art">
              <div class="seo-card-art__map">
                <div class="seo-card-art__pin"></div>
                <div class="seo-card-art__pin seo-card-art__pin--2"></div>
                <div class="seo-card-art__rays"></div>
              </div>
              <div class="seo-card-art__badges"><span>#1 Local</span><span>3 Towns</span></div>
            </div>
          </div>
          <div class="case-card__body">
            <span class="case-card__num">02 / SEO + GEO</span>
            <h3 class="case-card__title">Harrison McPhee Arboriculture</h3>
            <p class="case-card__desc">A 30-year tree company that didn't exist on the internet. Now they can't take on new customers.</p>
            <div class="case-card__metrics"><span>+340% organic traffic</span></div>
            <a href="/case-studies/harrison-mcphee" class="case-card__link">VIEW THE FIELD NOTES →</a>
          </div>
        </div>
      </div>

      <div class="case-card case-card--full">
        <div class="case-card__visual case-card__visual--web">
          <div class="web-card-art">
            <div class="web-card-art__device">
              <div class="web-card-art__screen">
                <div class="web-card-art__site-header"></div>
                <div class="web-card-art__site-hero"></div>
                <div class="web-card-art__site-body"></div>
              </div>
            </div>
            <div class="web-card-art__badge">92 Lighthouse</div>
          </div>
        </div>
        <div class="case-card__body case-card__body--web">
          <span class="case-card__num">03 / Web Design</span>
          <h3 class="case-card__title">Holliston Agricultural Commission</h3>
          <p class="case-card__desc">A clearer digital front door for a working local business. Technically it existed before. Nobody could find it, use it, or read it on a phone.</p>
          <div class="case-card__metrics"><span>+180% page views</span><span>92% mobile perf.</span></div>
          <a href="/case-studies/holliston-ag" class="case-card__link">VIEW THE SITE →</a>
        </div>
      </div>

      <div class="cases-cta">
        <a href="/case-studies" class="cases-cta__link">VIEW ALL WORK →</a>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="section section--process">
    <div class="wrap">
      <div class="section__header">
        <div>
          <span class="tag">Process</span>
          <h2>How it works</h2>
        </div>
        <span class="section__label">04</span>
      </div>
      <div class="process-grid">
        <div class="process-step">
          <span class="process-step__num">01</span>
          <h3>Find the friction</h3>
          <p>Audit what exists. Map every dead end, every drop-off, every "good enough" that's costing you.</p>
        </div>
        <div class="process-step">
          <span class="process-step__num">02</span>
          <h3>Make the plan</h3>
          <p>Prioritize what matters — to your business, your users, your growth. Cut the rest.</p>
        </div>
        <div class="process-step">
          <span class="process-step__num">03</span>
          <h3>Build the useful thing</h3>
          <p>Design, write, ship. Every piece earns its place, every feature has a reason.</p>
        </div>
        <div class="process-step">
          <span class="process-step__num">04</span>
          <h3>Measure and refine</h3>
          <p>Learn from real behavior. Kill what flops. Double down on what works.</p>
        </div>
      </div>
      <blockquote class="process-quote">
        "No black box. You see what is changing, why it matters, and what comes next."
      </blockquote>
    </div>
  </section>

  <!-- Automation -->
  <section class="section section--automation">
    <div class="wrap">
      <div class="automation-block">
        <div class="automation-block__header">
          <span class="tag">Practical Automation</span>
          <h2>The back office can do more</h2>
        </div>
        <p>Automate repetitive admin work without losing human oversight. Fixed price, no subscriptions, no black box.</p>
        <div class="automation-flow">
          <span>intake</span><span class="flow-arrow">→</span><span>validate</span><span class="flow-arrow">→</span><span>action</span><span class="flow-arrow">→</span><span>exception queue</span>
        </div>
        <a href="/services/automation" class="btn btn--outline-teal">Explore Automation →</a>
      </div>
    </div>
  </section>

  <!-- Primary CTA -->
  <section class="section section--cta" id="contact">
    <div class="wrap">
      <h2>Have a project that needs to pull its weight?</h2>
      <p>Tell us what is not working. We will help map a useful next step.</p>
      <div class="cta-footer">
        <a href="mailto:hello@crescentmoondesign.com" class="btn btn--primary">Start a Conversation →</a>
        <span class="cta-location">Based in Portola, CA — working nationwide</span>
      </div>
    </div>
  </section>

</BaseLayout>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
<script is:inline src="https://unpkg.com/split-type@0.3.4/umd/index.min.js" defer></script>
<script is:inline>
(function() {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('reduced-motion');
    return;
  }
  var timeout = setTimeout(function() { console.warn('[CMDesign] GSAP timed out'); }, 3000);
  function tryInit() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined' || typeof SplitType === 'undefined') return;
    clearTimeout(timeout);
    gsap.registerPlugin(ScrollTrigger);

    var tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    // Phase 1: Moon entrance
    tl.fromTo('.hero__moon-svg', { scale: 0.9, opacity: 0 }, { scale: 1, opacity: 1, duration: 1.2, ease: 'power2.out' });
    tl.to('.hero__moon-glow', { opacity: 1, duration: 0.8, ease: 'sine.inOut' }, '-=0.4');
    tl.to({}, { duration: 0.5 });

    // Phase 2: Eclipse + text sweep
    var sweepDur = 2.4;
    var sweepEase = 'power2.inOut';
    tl.to('.eclipse-shadow', { attr: { cx: 288 }, duration: sweepDur, ease: sweepEase });
    tl.fromTo('.hero__text', { opacity: 0, x: 60 }, { opacity: 1, x: 0, duration: sweepDur * 0.8, ease: sweepEase }, '-=0.6');
    tl.to('.hero__moon-glow', { opacity: 0.3, duration: sweepDur, ease: 'sine.in' }, '<');

    // Phase 3: Character settle
    var nameSplit = new SplitType('.agency-name', { types: 'chars' });
    var taglineSplit = new SplitType('.tagline', { types: 'words' });
    var introSplit = new SplitType('.services-intro', { types: 'chars' });
    tl.to('.hero__moon-glow', { opacity: 0.7, scale: 1.06, duration: 0.5, ease: 'power2.out' });
    tl.to('.hero__moon-glow', { opacity: 0.4, scale: 1, duration: 0.9, ease: 'sine.inOut' });
    tl.to(nameSplit.chars, { opacity: 1, x: 0, duration: 0.55, stagger: 0.028, ease: 'power3.out' }, '-=1.1');
    tl.to(taglineSplit.words, { opacity: 1, x: 0, duration: 0.45, stagger: 0.05, ease: 'power3.out' }, '-=0.7');
    tl.to(introSplit.chars, { opacity: 1, x: 0, duration: 0.35, stagger: 0.012, ease: 'power2.out' }, '-=0.4');

    // Phase 4: Moon docks
    gsap.to('.hero__moon-container', {
      scrollTrigger: { trigger: '.hero', start: '60% top', end: 'bottom top', scrub: 1 },
      scale: 0.08, x: function() { return -window.innerWidth * 0.42; }, y: function() { return -window.innerHeight * 0.38; }, opacity: 0, ease: 'none'
    });
    gsap.to('.moon-dock', {
      scrollTrigger: { trigger: '.hero', start: '75% top', end: 'bottom top', scrub: 1 },
      opacity: 1, scale: 1, ease: 'none'
    });

    // Service detail scroll-spy: fade active, dim others
    var detailSections = document.querySelectorAll('.service-detail');
    var sections = document.querySelectorAll('.service-detail');
    sections.forEach(function(section, i) {
      ScrollTrigger.create({
        trigger: section, start: 'top center', end: 'bottom center',
        onEnter: function() {
          gsap.to(section, { opacity: 1, duration: 0.4 });
          detailSections.forEach(function(s, j) { if (j !== i) gsap.to(s, { opacity: 0.15, duration: 0.4 }); });
        },
        onEnterBack: function() {
          gsap.to(section, { opacity: 1, duration: 0.4 });
          detailSections.forEach(function(s, j) { if (j !== i) gsap.to(s, { opacity: 0.15, duration: 0.4 }); });
        }
      });
    });
  }
  if (typeof gsap !== 'undefined') { tryInit(); }
  else {
    var iv = setInterval(function() {
      if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined' && typeof SplitType !== 'undefined') {
        clearInterval(iv); tryInit();
      }
    }, 100);
  }
})();
</script>

<style>
  /* === HERO === */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    min-height: 100vh;
    padding-top: 12vh;
    overflow: hidden;
    background: var(--bg) url('https://cm-circle.github.io/Crescent-Moon-Design/nightsky.webp') center center / cover no-repeat fixed;
  }
  @supports not (background: url('https://cm-circle.github.io/Crescent-Moon-Design/nightsky.webp')) {
    .hero { background: var(--bg) url('https://cm-circle.github.io/Crescent-Moon-Design/nightsky.jpg') center center / cover no-repeat fixed; }
  }
  .hero::before {
    content: ''; position: absolute; inset: 0;
    background: rgba(5, 5, 8, 0.55); z-index: 1; pointer-events: none;
  }
  .hero__moon-container {
    position: relative; width: clamp(420px, 58vw, 780px); height: clamp(420px, 58vw, 780px);
    flex-shrink: 0; margin-left: clamp(-60px, -4vw, -20px); overflow: visible; z-index: 2;
  }
  .hero__moon-svg { width: 100%; height: 100%; display: block; }
  .moon-img { display: block; }
  .hero__moon-glow {
    position: absolute; inset: -15%; border-radius: 50%;
    background: radial-gradient(circle, var(--glow) 0%, transparent 65%);
    opacity: 0; pointer-events: none;
  }
  .hero__text {
      position: absolute; z-index: 3; left: 42%; top: 50%;
      transform: translateY(-50%) translateX(60px); opacity: 0; text-align: left; white-space: nowrap;
    }
  .hero__title { font-size: clamp(2.7rem, 4.8vw, 4.5rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.08; margin-bottom: 0.9rem; color: var(--fg); }
  .hero__tagline { font-size: clamp(1.28rem, 2.1vw, 1.65rem); font-weight: 300; color: var(--accent); margin-bottom: 1.4rem; letter-spacing: 0.01em; line-height: 1.5; }
  .hero__services { font-size: clamp(0.98rem, 1.5vw, 1.2rem); color: var(--muted); text-transform: uppercase; letter-spacing: 0.18em; }
  .hero__scroll-cue {
    position: absolute; bottom: 2.5rem; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 0.4rem; z-index: 2;
  }
  .hero__scroll-text { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.22em; color: var(--muted); }
  @keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }

  /* === METRICS STRIP === */
  .metrics-strip {
    background: rgba(10, 10, 18, 0.6);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    padding: 1.25rem 0;
    position: relative;
    z-index: 2;
  }
  .metrics-strip__inner {
    max-width: 1100px; margin: 0 auto; padding: 0 2rem;
    display: flex; justify-content: center; gap: 3.5rem; flex-wrap: wrap;
  }
  .metrics-strip__item {
    display: flex; flex-direction: column; align-items: center; gap: 0.15rem;
  }
  .metrics-strip__value {
    font-size: 1.4rem; font-weight: 700; color: var(--accent); letter-spacing: -0.02em;
  }
  .metrics-strip__label {
    font-size: 0.6rem; text-transform: uppercase; letter-spacing: 0.16em; color: var(--muted);
  }
  @media (max-width: 700px) {
    .metrics-strip__inner { gap: 2rem; }
  }

  /* === DOCKED MOON === */
  .moon-dock {
    position: fixed; top: 16px; left: 16px; width: 52px; height: 52px;
    z-index: 100; opacity: 0; transform: scale(0.5); pointer-events: none;
  }
  .moon-dock svg { width: 100%; height: 100%; }

  /* === SERVICE DETAIL RAIL === */
  .service-detail {
    min-height: 85vh; display: flex; align-items: center;
    background: var(--bg-solid); padding: 5rem 0; position: relative;
  }
  .service-detail + .service-detail {
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  .service-detail:not(.active) { opacity: 0.15; }
  .service-detail.active { opacity: 1; }
  .service-detail__inner {
    max-width: 1100px; margin: 0 auto; padding: 0 2rem;
    display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;
  }
  .service-detail__number {
    font-size: 0.7rem; font-weight: 700; letter-spacing: 0.2em;
    color: var(--red); margin-bottom: 0.5rem; text-transform: uppercase;
  }
  .service-detail__content h2 { font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 700; letter-spacing: -0.03em; color: var(--fg); margin-bottom: 0.5rem; }
  .service-detail__tagline { font-size: 1.1rem; color: var(--accent); margin-bottom: 2rem; font-style: italic; }
  .service-detail__list { list-style: none; padding: 0; margin: 0; }
  .service-detail__list li { font-size: 0.95rem; color: var(--fg); padding: 0.6rem 0; border-bottom: 1px solid rgba(255,255,255,0.05); }
  .service-detail__list li strong { color: var(--accent); font-weight: 600; }
  .service-detail__flow {
    text-align: center; margin-top: 1.5rem; font-size: 0.75rem;
    letter-spacing: 0.15em; color: var(--muted); text-transform: uppercase;
  }

  /* Browser frame */
  .browser-frame { background: #1a1a2e; border-radius: 10px; overflow: hidden; border: 1px solid rgba(255,255,255,0.08); }
