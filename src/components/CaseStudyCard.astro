---
interface Props {
  title: string;
  client: string;
  tagline: string;
  category: string;
  stats: Array<{ label: string; value: string }>;
  slug: string;
}

const { title, client, tagline, category, stats, slug } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}case-studies/${slug}`;
---

<a href={href} class="case-card">
  <span class="case-card__category">{category}</span>
  <h3 class="case-card__title">{title}</h3>
  <p class="case-card__tagline">{tagline}</p>
  <div class="case-card__stats">
    {stats.slice(0, 2).map(stat => (
      <div class="case-card__stat">
        <span class="case-card__stat-value">{stat.value}</span>
        <span class="case-card__stat-label">{stat.label}</span>
      </div>
    ))}
  </div>
  <span class="case-card__link">Read Case Study →</span>
</a>

<style>
  .case-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2.5rem 2rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--border-radius);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s ease, transform 0.2s ease;
  }

  .case-card:hover {
    border-color: var(--border-hover);
    transform: translateY(-3px);
  }

  .case-card__category {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--red);
  }

  .case-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--fg);
  }

  .case-card__tagline {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--muted);
  }

  .case-card__stats {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .case-card__stat {
    display: flex;
    flex-direction: column;
  }

  .case-card__stat-value {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--accent);
  }

  .case-card__stat-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin-top: 0.2rem;
  }

  .case-card__link {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--red);
    margin-top: 0.5rem;
  }
</style>