---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Crescent Moon Design — We craft digital experiences that eclipse the ordinary.">

  <!-- Docked moon logo (decorative) -->
  <div class="moon-dock" aria-hidden="true">
    <svg viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
      <defs>
        <mask id="dock-mask-hero">
          <rect width="400" height="400" fill="black"/>
          <circle cx="200" cy="200" r="185" fill="white"/>
          <circle cx="288" cy="200" r="130" fill="black"/>
        </mask>
      </defs>
      <title>Crescent Moon Design logo</title>
      <image xlink:href={`${base}moon.webp`} fetchpriority="high" loading="eager" x="15" y="15" width="370" height="370"
             preserveAspectRatio="xMidYMid slice" mask="url(#dock-mask-hero)"/>
    </svg>
  </div>

      <!-- Hero -->
      <section class="hero">
        <div class="hero__moon-container">
          <div class="hero__moon-glow"></div>
          <svg class="hero__moon-svg" viewBox="0 0 400 400" role="img" aria-label="Crescent moon with eclipse animation" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
            <defs>
              <mask id="eclipse-mask">
                <rect width="400" height="400" fill="black"/>
                <circle cx="200" cy="200" r="185" fill="white"/>
                <circle class="eclipse-shadow" cx="620" cy="200" r="130" fill="black"/>
              </mask>
            </defs>
            <title>Crescent moon with eclipse animation</title>
            <image class="moon-img" xlink:href={`${base}moon.webp`} fetchpriority="high" loading="eager"
                           x="15" y="15" width="370" height="370"
                           preserveAspectRatio="xMidYMid slice"
                           mask="url(#eclipse-mask)"/>
                  </svg>

                  <div class="hero__text">
                    <h1 class="hero__title agency-name">Crescent Moon Design</h1>
                    <p class="hero__tagline tagline">We craft digital experiences that eclipse the ordinary</p>
                    <p class="hero__services services-intro">Web Design &bull; Social Media &bull; SEO / GEO</p>
                  </div>
                </div>
                <div class="hero__scroll-cue" aria-hidden="true">
                  <span class="hero__scroll-text">Scroll</span>
                  <span class="hero__scroll-arrow">↓</span>
                </div>
              </section>

  <!-- Services Grid (3 columns) -->
  <section class="services-grid" id="services">
    <div class="wrap">
      <h2 class="section__title">What we do</h2>
      <div class="services-grid__inner">
        <article class="service-col">
          <div class="service-col__number">01</div>
          <h3 class="service-col__title">Web Design</h3>
          <p class="service-col__tagline">Sites that pull their weight</p>
          <ul class="service-col__list">
            <li><strong>Clear offer</strong> — every page has a job and does it</li>
            <li><strong>Mobile-first</strong> — built for thumbs first, cursors second</li>
            <li><strong>Fast pages</strong> — sub-second first paint, no excuses</li>
            <li><strong>Easy edits</strong> — you own your content, not a plugin</li>
            <li><strong>Accessible</strong> — WCAG 2.1 AA, built in from the start</li>
          </ul>
          <a href="/services" class="service-col__link">Learn more →</a>
        </article>
        <article class="service-col">
          <div class="service-col__number">02</div>
          <h3 class="service-col__title">Social Media</h3>
          <p class="service-col__tagline">Content with gravitational pull</p>
          <ul class="service-col__list">
            <li><strong>Platform-native</strong> — each channel gets what it needs</li>
            <li><strong>Monthly calendars</strong> — consistent, zero panic posting</li>
            <li><strong>Brand voice</strong> — defined once, used everywhere</li>
            <li><strong>Community</strong> — engagement that builds loyalty</li>
            <li><strong>Reporting</strong> — know what's working, kill what isn't</li>
          </ul>
          <a href="/services" class="service-col__link">Learn more →</a>
        </article>
        <article class="service-col">
          <div class="service-col__number">03</div>
          <h3 class="service-col__title">SEO / GEO</h3>
          <p class="service-col__tagline">Found by the right people</p>
          <ul class="service-col__list">
            <li><strong>Technical audits</strong> — find and fix what's blocking you</li>
            <li><strong>Local SEO</strong> — dominate your zip code</li>
            <li><strong>Content architecture</strong> — structure search engines reward</li>
            <li><strong>GEO</strong> — optimized for AI answer engines</li>
            <li><strong>Link building</strong> — earn the trust that rankings measure</li>
          </ul>
          <a href="/services" class="service-col__link">Learn more →</a>
        </article>
      </div>
    </div>
  </section>

  <!-- Process (4 steps) -->
  <section class="process" id="process">
    <div class="wrap">
      <h2 class="section__title">How it works</h2>
      <div class="process-grid">
        <div class="process-step">
          <span class="process-step__num">01</span>
          <h3 class="process-step__title">Find the friction</h3>
          <p class="process-step__desc">A short call to locate the leak in your funnel.</p>
        </div>
        <div class="process-step">
          <span class="process-step__num">02</span>
          <h3 class="process-step__title">Make the plan</h3>
          <p class="process-step__desc">A fixed-price roadmap with no surprise invoices.</p>
        </div>
        <div class="process-step">
          <span class="process-step__num">03</span>
          <h3 class="process-step__title">Build the useful thing</h3>
          <p class="process-step__desc">Ships fast, works on every screen, is easy to edit.</p>
        </div>
        <div class="process-step">
          <span class="process-step__num">04</span>
          <h3 class="process-step__title">Measure and refine</h3>
          <p class="process-step__desc">We track what happens after launch and keep improving.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Automation -->
  <section class="automation" id="automation">
    <div class="wrap">
      <div class="automation__inner">
        <div class="automation__copy">
          <h2 class="automation__title">The back office can do more</h2>
          <p class="automation__desc">Custom code and AI workflows for the busy-work that eats your week.</p>
        </div>
        <a href="/#contact" class="btn btn--primary automation__cta">Explore Automation →</a>
      </div>
    </div>
  </section>

  <!-- Case Studies -->
  <section class="case-studies" id="work">
    <div class="wrap">
      <h2 class="section__title">Recent work</h2>
      <div class="case-studies__grid">
        <a href="/case-studies/brookline-property" class="case-card">
          <span class="case-card__tag">Web Design</span>
          <h3 class="case-card__title">Brookline Property Group</h3>
          <p class="case-card__desc">Real estate site redesign with 340% organic traffic increase</p>
        </a>
        <a href="/case-studies/harrison-mcphee" class="case-card">
          <span class="case-card__tag">Social Media</span>
          <h3 class="case-card__title">Harrison & McPhee</h3>
          <p class="case-card__desc">Brand strategy and social presence overhaul</p>
        </a>
        <a href="/case-studies/holliston-ag" class="case-card">
          <span class="case-card__tag">SEO / GEO</span>
          <h3 class="case-card__title">Holliston Agricultural</h3>
          <p class="case-card__desc">Local SEO dominance — 92 Lighthouse score</p>
        </a>
      </div>
      <div class="case-studies__cta">
        <a href="/case-studies" class="btn btn--ghost">View all work →</a>
      </div>
    </div>
  </section>

  <!-- Primary CTA -->
  <section class="cta" id="contact">
    <div class="wrap">
      <h2 class="cta__title">Have a project that needs to pull its weight?</h2>
      <p class="cta__desc">Tell us what is not working. We will help map a useful next step.</p>
      <div class="cta__footer">
        <a href="mailto:hello@crescentmoondesign.com" class="btn btn--primary">Start a Conversation →</a>
        <span class="cta-location">Based in Portola, CA — working nationwide</span>
      </div>
    </div>
  </section>

</BaseLayout>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
<script is:inline src="https://unpkg.com/split-type@0.3.4/umd/index.min.js" defer></script>
<script is:inline>
(function() {
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('reduced-motion');
    return;
  }
  var timeout = setTimeout(function() { console.warn('[CMDesign] GSAP timed out'); }, 3000);
  function tryInit() {
    if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined' || typeof SplitType === 'undefined') return;
    clearTimeout(timeout);
    gsap.registerPlugin(ScrollTrigger);

    var tl = gsap.timeline({ defaults: { ease: 'power3.out' } });

    // Phase 1: Moon entrance
    tl.fromTo('.hero__moon-svg', { scale: 0.9, opacity: 0 }, { scale: 1, opacity: 1, duration: 1.2, ease: 'power2.out' });
    tl.to('.hero__moon-glow', { opacity: 1, duration: 0.8, ease: 'sine.inOut' }, '-=0.4');
    tl.to({}, { duration: 0.5 });

    // Phase 2: Eclipse + text sweep
    var sweepDur = 2.4;
    var sweepEase = 'power2.inOut';
    tl.to('.eclipse-shadow', { attr: { cx: 288 }, duration: sweepDur, ease: sweepEase });
    tl.fromTo('.hero__text', { opacity: 0, x: 60 }, { opacity: 1, x: 0, duration: sweepDur * 0.8, ease: sweepEase }, '-=0.6');
    tl.to('.hero__moon-glow', { opacity: 0.3, duration: sweepDur, ease: 'sine.in' }, '<');

    // Phase 3: Character settle
    var nameSplit = new SplitType('.agency-name', { types: 'chars' });
    var taglineSplit = new SplitType('.tagline', { types: 'words' });
    var introSplit = new SplitType('.services-intro', { types: 'chars' });
    tl.to('.hero__moon-glow', { opacity: 0.7, scale: 1.06, duration: 0.5, ease: 'power2.out' });
    tl.to('.hero__moon-glow', { opacity: 0.4, scale: 1, duration: 0.9, ease: 'sine.inOut' });
    tl.to(nameSplit.chars, { opacity: 1, x: 0, duration: 0.55, stagger: 0.028, ease: 'power3.out' }, '-=1.1');
    tl.to(taglineSplit.words, { opacity: 1, x: 0, duration: 0.45, stagger: 0.05, ease: 'power3.out' }, '-=0.7');
    tl.to(introSplit.chars, { opacity: 1, x: 0, duration: 0.35, stagger: 0.012, ease: 'power2.out' }, '-=0.4');

    // Phase 4: Moon docks
    gsap.to('.hero__moon-container', {
      scrollTrigger: { trigger: '.hero', start: '60% top', end: 'bottom top', scrub: 1 },
      scale: 0.08, x: function() { return -window.innerWidth * 0.42; }, y: function() { return -window.innerHeight * 0.38; }, opacity: 0, ease: 'none'
    });
    gsap.to('.moon-dock', {
      scrollTrigger: { trigger: '.hero', start: '75% top', end: 'bottom top', scrub: 1 },
      opacity: 1, scale: 1, ease: 'none'
    });

    // Scroll-reveal for sections below hero
    gsap.utils.toArray('.service-col, .process-step, .automation, .cta').forEach(function(el) {
      gsap.fromTo(el, { opacity: 0, y: 40 }, {
        opacity: 1, y: 0, duration: 0.8, ease: 'power3.out',
        scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none reverse' }
      });
    });
  }
  if (typeof gsap !== 'undefined') { tryInit(); }
  else {
    var iv = setInterval(function() {
      if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined' && typeof SplitType !== 'undefined') {
        clearInterval(iv); tryInit();
      }
    }, 100);
  }
})();
</script>

<style>
  /* === HERO === */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
    min-height: 100vh;
    padding-top: 12vh;
    overflow: hidden;
    background: var(--bg) url('https://cm-circle.github.io/Crescent-Moon-Design/nightsky.webp') center center / cover no-repeat fixed;
  }
  @supports not (background: url('https://cm-circle.github.io/Crescent-Moon-Design/nightsky.webp')) {
    .hero { background: var(--bg) url('https://cm-circle.github.io/Crescent-Moon-Design/nightsky.jpg') center center / cover no-repeat fixed; }
  }
  .hero::before {
    content: ''; position: absolute; inset: 0;
    background: rgba(5, 5, 8, 0.55); z-index: 1; pointer-events: none;
  }
  .hero__moon-container {
    position: relative; width: clamp(420px, 58vw, 780px); height: clamp(420px, 58vw, 780px);
    flex-shrink: 0; margin-left: clamp(-60px, -4vw, -20px); overflow: visible; z-index: 2;
  }
  .hero__moon-svg { width: 100%; height: 100%; display: block; }
  .moon-img { display: block; }
  .hero__moon-glow {
    position: absolute; inset: -15%; border-radius: 50%;
    background: radial-gradient(circle, var(--glow) 0%, transparent 65%);
    opacity: 0; pointer-events: none;
  }
  .hero__text {
      position: absolute; z-index: 3; left: 42%; top: 50%;
      transform: translateY(-50%) translateX(60px); opacity: 0; text-align: left; white-space: normal; max-width: 92vw;
    }
  .hero__title { font-size: clamp(2.7rem, 4.8vw, 4.5rem); font-weight: 700; letter-spacing: -0.03em; line-height: 1.08; margin-bottom: 0.9rem; color: var(--fg); }
  .hero__tagline { font-size: clamp(1.28rem, 2.1vw, 1.65rem); font-weight: 300; color: var(--accent); margin-bottom: 1.4rem; letter-spacing: 0.01em; line-height: 1.5; }
  .hero__services { font-size: clamp(0.98rem, 1.5vw, 1.2rem); color: var(--muted); text-transform: uppercase; letter-spacing: 0.18em; }
  .hero__scroll-cue {
    position: absolute; bottom: 2.5rem; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 0.4rem; z-index: 2;
  }
  .hero__scroll-text { font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.22em; color: var(--muted); }
  .hero__scroll-arrow { font-size: 1rem; color: var(--muted); animation: bounce 1.5s infinite; }
  @keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }

  /* === DOCKED MOON === */
  .moon-dock {
    position: fixed; top: 16px; left: 16px; width: 52px; height: 52px;
    z-index: 100; opacity: 0; transform: scale(0.5); pointer-events: none;
  }
  .moon-dock svg { width: 100%; height: 100%; }

  /* === WRAP === */
  .wrap { max-width: 1100px; margin: 0 auto; padding: 0 2rem; }

  /* === SERVICES GRID === */
  .services-grid {
    background: var(--bg-solid);
    padding: 6rem 0;
    border-top: 1px solid rgba(255,255,255,0.04);
  }
  .section__title {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--fg);
    margin-bottom: 3rem;
    text-align: center;
  }
  .services-grid__inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .service-col {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px;
    padding: 2.5rem 2rem;
    display: flex;
    flex-direction: column;
    transition: border-color 0.3s, background 0.3s;
  }
  .service-col:hover {
    border-color: rgba(230,57,70,0.4);
    background: rgba(230,57,70,0.03);
  }
  .service-col__number {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--red);
    margin-bottom: 0.75rem;
  }
  .service-col__title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--fg);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }
  .service-col__tagline {
    font-size: 1rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }
  .service-col__list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    flex: 1;
  }
  .service-col__list li {
    font-size: 0.9rem;
    color: var(--fg);
    line-height: 1.7;
    margin-bottom: 0.75rem;
    padding-left: 1.25rem;
    position: relative;
  }
  .service-col__list li::before {
    /* decorative */ content: '';
    width: 6px; height: 6px; border-radius: 50%; background: var(--accent);
    display: inline-block;
    position: absolute;
    left: 0;
    color: var(--accent);
    font-size: 0.85rem;
  }
  .service-col__list li strong {
    color: var(--fg);
  }
  .service-col__link {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--accent);
    text-decoration: none;
    transition: color 0.2s;
    align-self: flex-start;
  }
  .service-col__link:hover { color: var(--red); }

  /* === PROCESS === */
  .process {
    background: var(--bg);
    padding: 6rem 0;
    border-top: 1px solid rgba(255,255,255,0.04);
  }
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  .process-step {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px;
    padding: 2.5rem 1.5rem;
    text-align: center;
    transition: border-color 0.3s, background 0.3s;
  }
  .process-step:hover {
    border-color: rgba(230,57,70,0.4);
    background: rgba(230,57,70,0.03);
  }
  .process-step__num {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--red);
    margin-bottom: 1rem;
  }
  .process-step__title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--fg);
    margin-bottom: 0.75rem;
    letter-spacing: -0.01em;
  }
  .process-step__desc {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.6;
  }

  /* === AUTOMATION === */
  .automation {
    background: var(--bg-solid);
    padding: 5rem 0;
    border-top: 1px solid rgba(255,255,255,0.04);
  }
  .automation__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    max-width: 900px;
    margin: 0 auto;
  }
  .automation__title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 700;
    color: var(--fg);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }
  .automation__desc {
    font-size: 1rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .automation__cta { flex-shrink: 0; }

  /* === CASE STUDIES === */
  .case-studies {
    padding: 6rem 0;
    border-top: 1px solid rgba(255,255,255,0.04);
  }
  .case-studies__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  .case-card {
    display: block;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px;
    padding: 2rem;
    text-decoration: none;
    transition: border-color 0.3s, background 0.3s, transform 0.2s;
  }
  .case-card:hover {
    border-color: rgba(230,57,70,0.4);
    background: rgba(230,57,70,0.03);
    transform: translateY(-3px);
  }
  .case-card__tag {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--red);
    display: block;
    margin-bottom: 0.75rem;
  }
  .case-card__title {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--fg);
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }
  .case-card__desc {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.5;
    margin: 0;
  }
  .case-studies__cta {
    text-align: center;
  }

  /* === CTA === */
  .cta {
    background: var(--bg-solid);
    padding: 6rem 0;
    border-top: 1px solid rgba(255,255,255,0.04);
    text-align: center;
  }
  .cta__title {
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 700;
    color: var(--fg);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .cta__desc {
    font-size: 1.1rem;
    color: var(--muted);
    margin-bottom: 2.5rem;
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.7;
  }
  .cta__footer {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cta-location {
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* === BUTTONS === */
  .btn { display: inline-block; padding: 0.9rem 2rem; border-radius: 8px; font-size: 0.82rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; text-decoration: none; transition: all 0.2s; cursor: pointer; }
  .btn--primary { background: var(--red); color: #fff; border: 1px solid var(--red); }
  .btn--primary:hover { background: transparent; color: var(--red); }

  /* === SplitType === */
  .agency-name .char { display: inline-block; opacity: 0; transform: translateX(30px); }
  .tagline .word { display: inline-block; opacity: 0; transform: translateX(24px); }
  .services-intro .char { display: inline-block; opacity: 0; transform: translateX(16px); }

  /* === RESPONSIVE === */
  @media (max-width: 900px) {
      /* Too small to keep text + moon side by side — stack text under the moon */
      .hero { flex-direction: column; justify-content: center; padding: 2rem 1rem; }
      .hero__moon-container { margin-left: 0; width: clamp(300px, 70vw, 520px); height: clamp(300px, 70vw, 520px); }
      .hero__text { position: relative; left: 0; top: auto; transform: none; max-width: 100%; margin: 1.5rem auto 0; text-align: center; white-space: normal; }
      .services-grid__inner { grid-template-columns: 1fr; }
      .process-grid { grid-template-columns: 1fr 1fr; }
      .automation__inner { flex-direction: column; text-align: center; }
      .automation__cta { width: 100%; text-align: center; }
  }
  @media (max-width: 600px) {
      .process-grid { grid-template-columns: 1fr; }
  }
